---
export interface Props {
  title: string;
  description?: string | null;
  date?: Date | null;
  readingTime?: number | null;
  tags?: string[];
  slug: string;
  featured?: boolean;
  image?: {
    src: string;
    srcset?: string;
    sizes?: string;
    alt: string;
  };
}

const {
  title,
  description,
  date,
  readingTime,
  tags = [],
  slug,
  featured = false,
  image = {
    src: '/img/landing/optimized/blog-start-620.webp',
    srcset: '/img/landing/optimized/blog-start-360.webp 360w, /img/landing/optimized/blog-start-620.webp 620w, /img/landing/optimized/blog-start-820.webp 820w',
    sizes: '(min-width: 961px) 360px, calc(100vw - 56px)',
    alt: 'Przykładowy obraz wpisu blogowego',
  },
} = Astro.props;

const formattedDate = date
  ? new Intl.DateTimeFormat('pl-PL', { year: 'numeric', month: 'long', day: 'numeric' }).format(date)
  : null;
---

<article class={`blog-card${featured ? ' blog-card--featured' : ''}`}>
  {featured && <span class="featured-label">Polecany wpis</span>}
  <a href={`/blog/${slug}`} class="blog-card-link">
    {image && (
      <img
        class="blog-card-image"
        src={image.src}
        srcset={image.srcset}
        sizes={image.sizes}
        alt={image.alt}
        width="620"
        height="388"
        loading={featured ? 'eager' : 'lazy'}
        decoding="async"
      />
    )}
    <h3 class="blog-card-title">{title}</h3>
    {description && <p class="blog-card-description">{description}</p>}
    <div class="blog-card-meta">
      {formattedDate && <time datetime={date?.toISOString()}>{formattedDate}</time>}
      {readingTime && <span>{readingTime} min czytania</span>}
    </div>
    {tags.length > 0 && (
      <div class="blog-card-tags">
        {tags.slice(0, 3).map(tag => <span class="tag">{tag}</span>)}
      </div>
    )}
  </a>
</article>
