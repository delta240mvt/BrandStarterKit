---
import { HOME } from '@/data/home';

const { realizations } = HOME;
---

{realizations.items.length > 0 && (
  <section class="realizations reveal" id="realizacje">
    <div class="section-container">
      <div class="section-header">
        <h2 class="section-heading">{realizations.heading}</h2>
        <p>{realizations.description}</p>
      </div>

      <div class="realization-grid">
        {realizations.items.map((item) => (
          <article class="realization-card">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <strong>{item.result}</strong>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .realizations {
    padding: 5rem 1.5rem;
    background: var(--bg-surface);
  }

  .section-container {
    max-width: 980px;
    margin: 0 auto;
  }

  .section-header {
    max-width: 680px;
    margin-bottom: 2rem;
  }

  .section-header p {
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .realization-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .realization-card {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.5rem;
    background: var(--bg-elevated);
  }

  .realization-card h3 {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    margin-bottom: 0.75rem;
  }

  .realization-card p {
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .realization-card strong {
    color: var(--teal);
    font-size: var(--text-sm);
  }

  @media (max-width: 760px) {
    .realization-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
