---
import { HOME } from '@/data/home';
import { SITE } from '@/data/site';

const { contact } = HOME;
---

<section class="contact reveal" id="kontakt">
  <div class="contact-container">
    <h2 class="section-heading">{contact.heading}</h2>
    <p class="contact-text">{contact.description}</p>

    <div class="contact-actions">
      <a href={`mailto:${SITE.contact.email}`} class="btn-primary">{contact.emailCtaLabel}</a>
      {SITE.contact.phone && <a href={`tel:${SITE.contact.phone.replaceAll(' ', '')}`} class="btn-ghost">{SITE.contact.phone}</a>}
    </div>

    {SITE.contact.address && <p class="contact-address">{SITE.contact.address}</p>}
  </div>
</section>

<style>
  .contact {
    padding: 5rem 1.5rem;
    background: var(--bg-elevated);
  }

  .contact-container {
    max-width: 760px;
    margin: 0 auto;
  }

  .contact-text {
    color: var(--text-secondary);
    font-size: var(--text-lg);
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .contact-address {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
</style>
