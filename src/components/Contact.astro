---
import { SITE } from '@/data/site';
---

<section class="section contact-panel reveal" id="kontakt">
  <div class="footer-cta">
    <img
      class="footer-cta__avatar"
      src="/img/landing/optimized/contact-avatar-260.webp"
      alt="Zdjęcie autora"
      width="80"
      height="80"
      loading="lazy"
      decoding="async"
    />
    <div class="footer-cta__content">
      <h2 class="footer-cta__title">Masz pomysł na nowy projekt?</h2>
      <p class="footer-cta__text">
        Napisz do nas. Opowiedz o swoich celach, a wspólnie wyznaczymy najlepszą drogę do ich realizacji.
      </p>

      <div class="contact-actions">
        <a href={`mailto:${SITE.contact.email}`} class="btn btn--primary">Skontaktuj się <span aria-hidden="true">-&gt;</span></a>
      </div>
    </div>
  </div>
</section>
