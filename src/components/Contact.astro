---
import { SITE } from '@/data/site';
---

<section class="section contact-panel reveal" id="kontakt">
  <div class="footer-cta">
    <img
      class="footer-cta__avatar"
      src="/img/landing/optimized/contact-avatar-260.webp"
      alt="Zdjęcie autora startera"
      width="260"
      height="260"
      loading="lazy"
      decoding="async"
    />
    <div class="footer-cta__content">
      <h2 class="footer-cta__title">Chcesz budować z AI bez chaosu?</h2>
      <p class="footer-cta__text">
        Napisz do mnie. Opowiedz o swoim pomyśle, a pomogę dobrać rozwiązanie,
        które naprawdę działa.
      </p>

      <ul class="footer-cta__links" aria-label="Linki kontaktowe">
        <li>
          <a href={`mailto:${SITE.contact.email}`}>
            <span aria-hidden="true">@</span>
            {SITE.contact.email}
          </a>
        </li>
        <li>
          <a href="https://www.linkedin.com/" target="_blank" rel="noopener noreferrer">
            <span aria-hidden="true">in</span>
            LinkedIn
          </a>
        </li>
        <li>
          <a href="https://github.com/" target="_blank" rel="noopener noreferrer">
            <span aria-hidden="true">GH</span>
            GitHub
          </a>
        </li>
      </ul>

      <div class="contact-actions">
        <a href={`mailto:${SITE.contact.email}`} class="btn btn--primary">Skontaktuj się <span aria-hidden="true">-&gt;</span></a>
      </div>
    </div>
  </div>
</section>
