---
import { HOME } from '@/data/home';

const { hero } = HOME;
---

<section class="hero" id="start">
  <div class="hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 class="hero-title">{hero.title}</h1>
      <p class="hero-description">{hero.description}</p>

      <div class="hero-actions">
        <a href={hero.primaryCta.href} class="btn btn--primary">{hero.primaryCta.label} <span aria-hidden="true">-&gt;</span></a>
        <a href={hero.secondaryCta.href} class="btn btn--outline">{hero.secondaryCta.label}</a>
      </div>

      {hero.trustCues.length > 0 && (
        <ul class="trust-list" aria-label="Najważniejsze atuty">
          {hero.trustCues.map((cue) => <li>{cue}</li>)}
        </ul>
      )}
    </div>

    <div class="hero-media" aria-hidden="true">
      <div class="hero-panel">
        <img
          class="hero-panel__photo"
          src="/img/landing/optimized/portfolio-ai-workflow-620.webp"
          srcset="/img/landing/optimized/portfolio-ai-workflow-360.webp 360w, /img/landing/optimized/portfolio-ai-workflow-620.webp 620w, /img/landing/optimized/portfolio-ai-workflow-820.webp 820w"
          sizes="(min-width: 961px) 430px, calc(100vw - 56px)"
          alt=""
          width="620"
          height="388"
          loading="eager"
          decoding="async"
        />
        <img class="hero-panel__image" src="/img/landing/optimized/icon-product-system-128.webp" alt="" width="128" height="128" loading="eager" decoding="async" />
        <div>
          <p class="hero-panel__title">Oferta, realizacje i kontakt w jednym układzie.</p>
          <p class="hero-panel__text">Starter pod lokalne usługi, gotowy do szybkiego przepisania dla klienta.</p>
        </div>
      </div>
    </div>
  </div>
</section>
