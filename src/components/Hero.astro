---
import { HOME } from '@/data/home';

const { hero } = HOME;
---

<section class="hero" id="start">
  <div class="hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 class="hero-title">{hero.title}</h1>
      <p class="hero-description">{hero.description}</p>

      <div class="hero-actions">
        <a href={hero.primaryCta.href} class="btn btn--primary">{hero.primaryCta.label} <span aria-hidden="true">-&gt;</span></a>
        <a href={hero.secondaryCta.href} class="btn btn--outline">{hero.secondaryCta.label}</a>
      </div>

      {hero.trustCues.length > 0 && (
        <ul class="trust-list" aria-label="Najważniejsze atuty">
          {hero.trustCues.map((cue) => (
            <li>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="trust-icon"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>{cue}</span>
            </li>
          ))}
        </ul>
      )}
    </div>

    <div class="hero-media" aria-hidden="true">
      <div class="hero-panel">
        <img
          class="hero-panel__photo"
          src="/img/landing/optimized/hero_photo-768.webp"
          srcset="/img/landing/optimized/hero_photo-640.webp 640w, /img/landing/optimized/hero_photo-768.webp 768w"
          sizes="(min-width: 961px) 430px, 100vw"
          alt="Nowoczesne, jasne biuro"
          width="1024"
          height="1024"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <img class="hero-panel__image" src="/img/landing/optimized/icon-product-system-128.webp" alt="" width="128" height="128" loading="eager" decoding="async" />
        <div>
          <p class="hero-panel__title">Strona, blog i widoczność w jednym układzie.</p>
          <p class="hero-panel__text">Starter Astro 7 gotowy do dopasowania do Twojego nowego projektu.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .trust-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  :global(.trust-list li) {
    gap: 6px;
  }
  .trust-icon {
    color: var(--c-cta);
    flex-shrink: 0;
  }
  @media (max-width: 640px) {
    .trust-list {
      display: grid;
      grid-template-columns: 1fr;
      gap: 8px;
    }
    :global(.trust-list li) {
      justify-content: flex-start !important;
      padding: 12px 16px !important;
      font-size: 14px !important;
      gap: 12px !important;
    }
  }
</style>
