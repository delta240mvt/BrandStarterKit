---
import { HOME } from '@/data/home';

const { faq } = HOME;
---

{faq.items.length > 0 && (
  <section class="section reveal" id="faq">
      <header class="section-head-inline">
        <span class="section-heading">{faq.heading}</span>
        <span class="section-head__rule" aria-hidden="true"></span>
      </header>
      <div class="faq-list">
        {faq.items.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
  </section>
)}
