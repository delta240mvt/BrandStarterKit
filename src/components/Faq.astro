---
import { HOME } from '@/data/home';

const { faq } = HOME;
---

{faq.items.length > 0 && (
  <section class="faq reveal" id="faq">
    <div class="section-container">
      <h2 class="section-heading">{faq.heading}</h2>
      <div class="faq-list">
        {faq.items.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .faq {
    padding: 5rem 1.5rem;
    background: var(--bg-surface);
  }

  .section-container {
    max-width: 860px;
    margin: 0 auto;
  }

  .faq-list {
    display: grid;
    gap: 0.75rem;
  }

  details {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-elevated);
    padding: 1rem 1.25rem;
  }

  summary {
    cursor: pointer;
    font-family: var(--font-heading);
    font-weight: 600;
  }

  details p {
    color: var(--text-secondary);
    line-height: 1.7;
    margin-top: 0.75rem;
  }
</style>
