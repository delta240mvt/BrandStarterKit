---
import { HOME } from '@/data/home';

const { process } = HOME;
---

{process.items.length > 0 && (
  <section class="section section--warm reveal" id="proces">
    <header class="section-head-inline">
      <span class="section-heading">{process.heading}</span>
      <span class="section-head__rule" aria-hidden="true"></span>
    </header>
      <ol class="process-list">
        {process.items.map((item) => (
          <li>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </li>
        ))}
      </ol>
  </section>
)}
