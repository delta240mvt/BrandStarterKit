---
import { HOME } from '@/data/home';

const { process } = HOME;
---

{process.items.length > 0 && (
  <section class="section section--warm reveal process-section" id="proces">
    <header class="section-head-inline">
      <span class="section-heading">{process.heading}</span>
      <span class="section-head__rule" aria-hidden="true"></span>
    </header>
      <div class="process-layout">
        <ol class="process-steps">
          {process.items.map((item, i) => (
            <li class="process-step">
              <span class="process-step__number">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="process-step__title">{item.title}</h3>
                <p class="process-step__desc">{item.description}</p>
              </div>
            </li>
          ))}
        </ol>
        <img class="process-photo" src="/img/landing/optimized/process_photo.webp" alt="Współpraca i planowanie" loading="lazy" decoding="async" />
      </div>
  </section>
)}

<style>
  .process-section {
    padding-top: 48px;
    padding-bottom: 48px;
  }
  .process-layout {
    display: grid;
    gap: 40px;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    margin-top: 24px;
  }
  .process-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .process-step {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    padding: 18px 0;
    border-bottom: 1px solid var(--c-line);
  }
  .process-step__number {
    font-size: 13px;
    font-family: var(--ff-mono);
    color: var(--c-cta);
    font-weight: 600;
    min-width: 28px;
    padding-top: 2px;
  }
  .process-step__title {
    margin: 0 0 4px;
    font-size: 16px;
    font-weight: 500;
    color: var(--c-ink);
  }
  .process-step__desc {
    margin: 0;
    font-size: 14px;
    color: var(--c-ink-3);
    line-height: 1.5;
  }
  .process-photo {
    width: 100%;
    max-height: 320px;
    border-radius: var(--r-md);
    object-fit: cover;
    object-position: center;
    border: 1px solid var(--c-line);
    display: block;
  }
  
  @media (max-width: 768px) {
    .process-layout {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>

