---
import { HOME } from '@/data/home';

const { services } = HOME;
---

<section class="section reveal" id="oferta">
  <header class="section-head-inline">
    <span class="section-heading">{services.heading}</span>
    <span class="section-head__rule" aria-hidden="true"></span>
  </header>
  <h2 class="section-title">Oferta opisana tak, żeby klient szybko wybrał kolejny krok.</h2>
  <p class="section-lead">{services.description}</p>

    <div class="cards-grid mt-8">
      {services.items.map((service) => (
        <article class="service-card">
          <img class="card-icon" src="/img/landing/optimized/icon-code-automation-96.webp" alt="" width="96" height="96" loading="lazy" decoding="async" />
          <h3>{service.title}</h3>
          <p>{service.description}</p>
          <a href={service.href}>Zapytaj o usługę -&gt;</a>
        </article>
      ))}
    </div>
</section>
