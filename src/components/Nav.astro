---
import { NAVIGATION } from '@/data/navigation';
import { SITE } from '@/data/site';

const pathname = Astro.url.pathname;

function resolveHref(href: string): string {
  if (href.startsWith('#') && pathname !== '/') {
    return `/${href}`;
  }

  return href;
}
---

<nav class="nav" aria-label="Główne menu">
  <div class="nav-container">
    <a href="/" class="nav-logo" aria-label={`${SITE.displayName} - strona główna`}>
      <img src="/img/landing/optimized/logo_pracownia.webp" alt="" width="36" height="36" loading="eager" decoding="sync" />
      {SITE.displayName}
    </a>
    <ul class="nav-links" role="list">
      {NAVIGATION.main.map((item) => (
        <li>
          <a
            href={resolveHref(item.href)}
            class={`nav-link${pathname.startsWith(item.href) ? ' nav-link--active' : ''}`}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="nav-actions">
      <a href="/#kontakt" class="btn btn--primary btn--sm">Kontakt <span aria-hidden="true">-&gt;</span></a>
    </div>
    <button class="nav-toggle" id="nav-toggle" aria-label="Otwórz menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
  <ul class="nav-mobile" id="nav-mobile" role="list" aria-hidden="true">
    {NAVIGATION.main.map((item) => (
      <li>
        <a
          href={resolveHref(item.href)}
          class="nav-mobile-link"
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle');
  const mobile = document.getElementById('nav-mobile');

  if (toggle && mobile) {
    toggle.addEventListener('click', () => {
      const isOpen = mobile.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(isOpen));
      mobile.setAttribute('aria-hidden', String(!isOpen));
    });
  }
</script>
