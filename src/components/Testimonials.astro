---
import { HOME } from '@/data/home';

const { testimonials } = HOME;
---

{testimonials.items.length > 0 && (
  <section class="section section--warm reveal" id="opinie">
    <header class="section-head-inline">
      <span class="section-heading">{testimonials.heading}</span>
      <span class="section-head__rule" aria-hidden="true"></span>
    </header>
      <div class="testimonials-layout">
        <img class="testimonials-photo" src="/img/landing/optimized/testimonials_photo.webp" alt="Zadowolony klient" loading="lazy" decoding="async" />
        <div class="testimonials-cards">
          {testimonials.items.map((item) => (
            <figure class="testimonial-card" style="flex-shrink: 0;">
              <blockquote>{item.quote}</blockquote>
              <figcaption>
                <strong>{item.author}</strong>
                <span>{item.role}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
  </section>
)}

<style>
  .testimonials-layout {
    display: grid;
    gap: 48px;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 520px;
    align-items: stretch;
    margin-top: 32px;
  }
  .testimonials-photo {
    width: 100%;
    height: 100%;
    border-radius: var(--r-md);
    object-fit: cover;
    object-position: center;
    border: 1px solid var(--c-line);
    display: block;
  }
  .testimonials-cards {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 12px;
  }
  @media (max-width: 768px) {
    .testimonials-layout {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      gap: 32px;
    }
    .testimonials-photo {
      height: 320px;
      order: -1;
    }
    .testimonials-cards {
      overflow: visible;
      gap: 16px;
    }
  }
</style>
