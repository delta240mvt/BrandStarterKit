---
import { HOME } from '@/data/home';

const { about } = HOME;
---

<section class="section reveal" id="o-nas">
  <header class="section-head-inline">
    <span class="section-heading">{about.heading}</span>
    <span class="section-head__rule" aria-hidden="true"></span>
  </header>
  <div class="about-grid">
    <div class="about-content">
      <div>
        <h2 class="section-title">Prosty opis firmy, który buduje zaufanie przed kontaktem.</h2>
        <div class="about-copy">
          {about.body.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
      {about.highlights.length > 0 && (
        <ul class="highlight-list" aria-label="Najważniejsze informacje o firmie">
          {about.highlights.map((highlight) => <li>{highlight}</li>)}
        </ul>
      )}
    </div>
    <img
      class="about-photo"
      src="/img/landing/optimized/about_photo-768.webp"
      srcset="/img/landing/optimized/about_photo-640.webp 640w, /img/landing/optimized/about_photo-768.webp 768w"
      sizes="(min-width: 641px) 50vw, 100vw"
      alt="Zespół w biurze"
      width="1024"
      height="1024"
      loading="lazy"
      decoding="async"
    />
  </div>
</section>

<style>
  .about-content {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 32px;
  }
  .about-photo {
    width: 100%;
    height: 100%;
    border-radius: var(--r-md);
    object-fit: cover;
    border: 1px solid var(--c-line);
    display: block;
  }
  @media (max-width: 640px) {
    .about-photo {
      height: 320px;
    }
  }
</style>
