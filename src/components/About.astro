---
import { HOME } from '@/data/home';

const { about } = HOME;
---

<section class="section reveal" id="o-nas">
  <header class="section-head-inline">
    <span class="section-heading">{about.heading}</span>
    <span class="section-head__rule" aria-hidden="true"></span>
  </header>
  <div style="display: grid; gap: 48px; grid-template-columns: 1fr 1fr; align-items: stretch;">
    <div style="display: flex; flex-direction: column; justify-content: flex-start; gap: 32px;">
      <div>
        <h2 class="section-title">Prosty opis firmy, który buduje zaufanie przed kontaktem.</h2>
        <div class="about-copy">
          {about.body.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
      {about.highlights.length > 0 && (
        <ul class="highlight-list" aria-label="Najważniejsze informacje o firmie">
          {about.highlights.map((highlight) => <li>{highlight}</li>)}
        </ul>
      )}
    </div>
    <img src="/img/landing/optimized/about_photo.webp" alt="Zespół w biurze" style="width: 100%; height: 100%; border-radius: var(--r-md); object-fit: cover; border: 1px solid var(--c-line); display: block;" loading="lazy" decoding="async" />
  </div>
</section>
