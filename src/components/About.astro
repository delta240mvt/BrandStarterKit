---
import { HOME } from '@/data/home';

const { about } = HOME;
---

<section class="section reveal" id="o-nas">
  <header class="section-head-inline">
    <span class="section-heading">{about.heading}</span>
    <span class="section-head__rule" aria-hidden="true"></span>
  </header>
  <div class="about-grid">
    <div>
      <h2 class="section-title">Prosty opis firmy, który buduje zaufanie przed kontaktem.</h2>
      <div class="about-copy">
        {about.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
    {about.highlights.length > 0 && (
      <ul class="highlight-list" aria-label="Najważniejsze informacje o firmie">
        {about.highlights.map((highlight) => <li>{highlight}</li>)}
      </ul>
    )}
  </div>
</section>
