---
import BlogCard from './BlogCard.astro';
import { HOME } from '@/data/home';
import { getPublishedPosts } from '@/lib/blog';

const articles = (await getPublishedPosts()).slice(0, 3);
const { blogPreview } = HOME;

const blogImages = [
  {
    src: '/img/landing/optimized/blog-cover-1-820.webp',
    alt: 'Autor przy pracy — wpis 1',
  },
  {
    src: '/img/landing/optimized/blog-cover-2-820.webp',
    alt: 'Autor na spotkaniu — wpis 2',
  },
  {
    src: '/img/landing/optimized/blog-cover-3-820.webp',
    alt: 'Autor przy kawie — wpis 3',
  },
];
---

<section class="section section--warm blog-preview-section reveal" id="blog">
  <header class="section-head-inline">
    <span class="section-heading">{blogPreview.heading}</span>
    <span class="section-head__rule" aria-hidden="true"></span>
  </header>
  <div class="blog-preview-head">
    <div>
      <h2 class="section-title">Blog, który wzmacnia ofertę i odpowiada na pytania klientów.</h2>
      <p class="section-lead">
        Na landing page pokazujemy najnowszy wpis jako większy materiał, a cały blog zostaje gotowy do pozycjonowania prostych usług lokalnych.
      </p>
    </div>
    <a href="/blog" class="btn btn--outline">Wszystkie wpisy <span aria-hidden="true">-&gt;</span></a>
  </div>

    {articles.length > 0 ? (
      <div class="blog-preview-layout">
        {articles.map((article, i) => (
          <BlogCard
            title={article.title}
            description={article.description}
            date={article.pubDate}
            readingTime={article.readingTime}
            tags={article.tags}
            slug={article.slug}
            featured={false}
            image={blogImages[i % blogImages.length]}
          />
        ))}
      </div>
    ) : (
      <p class="empty-state">{blogPreview.emptyText}</p>
    )}
</section>
