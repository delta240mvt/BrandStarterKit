---
import BlogCard from './BlogCard.astro';
import { HOME } from '@/data/home';
import { getPublishedPosts } from '@/lib/blog';

const articles = (await getPublishedPosts()).slice(0, 3);
const { blogPreview } = HOME;
---

<section class="blog-preview reveal" id="blog">
  <div class="blog-preview-container">
    <h2 class="section-heading">{blogPreview.heading}</h2>

    {articles.length > 0 ? (
      <div class="blog-preview-grid">
        {articles.map((article, i) => (
          <BlogCard
            title={article.title}
            description={article.description}
            date={article.pubDate}
            readingTime={article.readingTime}
            tags={article.tags}
            slug={article.slug}
            featured={i === 0}
          />
        ))}
      </div>
    ) : (
      <p class="empty-state">{blogPreview.emptyText}</p>
    )}

    <div class="blog-preview-cta">
      <a href="/blog" class="blog-cta-link">{blogPreview.ctaLabel}</a>
    </div>
  </div>
</section>

<style>
  .blog-preview {
    padding: 5rem 1.5rem;
    background: var(--bg-base);
  }

  .blog-preview-container {
    max-width: 980px;
    margin: 0 auto;
  }

  .blog-preview-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .empty-state {
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .blog-preview-cta {
    text-align: center;
  }

  .blog-cta-link {
    color: var(--teal);
    text-decoration: none;
    font-weight: 600;
  }

  @media (max-width: 820px) {
    .blog-preview-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
