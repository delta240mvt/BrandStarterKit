---
import BlogCard from './BlogCard.astro';
import { HOME } from '@/data/home';
import { getPublishedPosts } from '@/lib/blog';

const articles = (await getPublishedPosts()).slice(0, 3);
const { blogPreview } = HOME;

const blogImages = [
  {
    src: '/img/landing/optimized/blog-start-820.webp',
    srcset: '/img/landing/optimized/blog-start-360.webp 360w, /img/landing/optimized/blog-start-620.webp 620w, /img/landing/optimized/blog-start-820.webp 820w',
    sizes: '(min-width: 961px) 620px, calc(100vw - 56px)',
    alt: 'Przykładowy cover wpisu blogowego',
  },
  {
    src: '/img/landing/optimized/portfolio-ai-workflow-620.webp',
    srcset: '/img/landing/optimized/portfolio-ai-workflow-360.webp 360w, /img/landing/optimized/portfolio-ai-workflow-620.webp 620w, /img/landing/optimized/portfolio-ai-workflow-820.webp 820w',
    sizes: '(min-width: 961px) 320px, calc(100vw - 56px)',
    alt: 'Przykładowy cover wpisu o realizacji usługi',
  },
];
---

<section class="section section--warm blog-preview-section reveal" id="blog">
  <header class="section-head-inline">
    <span class="section-heading">{blogPreview.heading}</span>
    <span class="section-head__rule" aria-hidden="true"></span>
  </header>
  <div class="blog-preview-head">
    <div>
      <h2 class="section-title">Blog, który wzmacnia ofertę i odpowiada na pytania klientów.</h2>
      <p class="section-lead">
        Na landing page pokazujemy najnowszy wpis jako większy materiał, a cały blog zostaje gotowy do pozycjonowania prostych usług lokalnych.
      </p>
    </div>
    <a href="/blog" class="btn btn--outline">Wszystkie wpisy <span aria-hidden="true">-&gt;</span></a>
  </div>

    {articles.length > 0 ? (
      <div class="blog-preview-layout">
        {articles.map((article, i) => (
          <BlogCard
            title={article.title}
            description={article.description}
            date={article.pubDate}
            readingTime={article.readingTime}
            tags={article.tags}
            slug={article.slug}
            featured={i === 0}
            image={blogImages[i % blogImages.length]}
          />
        ))}
        <aside class="blog-preview-aside">
          <p class="blog-preview-aside__title">Gotowe miejsce na ekspercką wiedzę.</p>
          <p class="blog-preview-aside__text">
            Wyjaśniaj ofertę, buduj zaufanie do swojego projektu i zbieraj ruch z wyszukiwarek.
          </p>
        </aside>
      </div>
    ) : (
      <p class="empty-state">{blogPreview.emptyText}</p>
    )}
</section>
