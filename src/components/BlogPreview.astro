---
import BlogCard from './BlogCard.astro';
import { HOME } from '@/data/home';
import { getPublishedPosts } from '@/lib/blog';

const articles = (await getPublishedPosts()).slice(0, 3);
const { blogPreview } = HOME;
---

<section class="brand-section brand-blog-preview" id="blog" aria-labelledby="blog-preview-heading">
  <div class="brand-shell">
  <header class="section-kicker">
    <span class="micro">{blogPreview.heading}</span>
  </header>
  <div class="brand-blog-intro">
    <div data-reveal>
      <h2 id="blog-preview-heading">Blog, w którym rozwijasz historię swojego projektu.</h2>
      <p>
        Publikuj aktualności, poradniki i case studies w MDX — każdy wpis otrzymuje własne metadata oraz dane strukturalne.
      </p>
    </div>
    <a href="/blog" class="brand-button">Wszystkie wpisy <span aria-hidden="true">↗</span></a>
  </div>

    {articles.length > 0 ? (
      <div class="brand-blog-grid">
        {articles.map((article) => (
          <BlogCard
            title={article.title}
            description={article.description}
            date={article.pubDate}
            readingTime={article.readingTime}
            tags={article.tags}
            slug={article.slug}
            featured={false}
            image={article.heroImage ? { src: article.heroImage, alt: article.title } : undefined}
          />
        ))}
      </div>
    ) : (
      <p class="empty-state">{blogPreview.emptyText}</p>
    )}
  </div>
</section>
