---
import Base from './Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import { absoluteUrl, getSitePresentation } from '@/lib/site';
import { buildArticleSchema } from '@/lib/schema';

export interface Props {
  title: string;
  description?: string | null;
  publishedAt?: Date | null;
  updatedAt?: Date | null;
  readingTime?: number | null;
  tags?: string[];
  author?: string;
  slug?: string;
  canonicalUrl?: string;
  heroImage?: string;
}

const {
  title,
  description,
  publishedAt,
  updatedAt,
  readingTime,
  tags = [],
  author = undefined,
  slug,
  canonicalUrl = undefined,
  heroImage,
} = Astro.props;

const site = getSitePresentation();
const resolvedAuthor = author ?? site.authorName;

const formattedDate = publishedAt
  ? new Intl.DateTimeFormat('pl-PL', { year: 'numeric', month: 'long', day: 'numeric' }).format(publishedAt)
  : null;

const resolvedCanonicalUrl = canonicalUrl ?? (slug ? absoluteUrl(`/blog/${slug}`) : absoluteUrl(Astro.url.pathname));
const schema = publishedAt
  ? buildArticleSchema({
      canonical: resolvedCanonicalUrl,
      title,
      description: description ?? site.blogDescription,
      publishedAt: publishedAt.toISOString(),
      updatedAt: updatedAt?.toISOString(),
      tags,
    })
  : null;
---

<Base
  title={`${title} — ${site.articleSuffix}`}
  description={description || undefined}
  canonical={resolvedCanonicalUrl}
  ogType="article"
  articlePublishedAt={publishedAt?.toISOString()}
  articleModifiedAt={updatedAt?.toISOString()}
>
  <Fragment slot="head">
    {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </Fragment>
  <Nav />
  <main id="main" class="blog-main" aria-label="Treść wpisu">
    <article class="article brand-shell">
      <nav class="article-navigation" aria-label="Nawigacja wpisu">
        <a href="/blog" class="brand-text-link">← Wszystkie wpisy</a>
        <span class="micro">Blog</span>
      </nav>
      <header class="article-header">
        <div class="article-meta">
          {formattedDate && (
            <time datetime={publishedAt?.toISOString()} class="article-date">
              {formattedDate}
            </time>
          )}
          {readingTime && (
            <span class="article-reading-time">{readingTime} min czytania</span>
          )}
        </div>
        <h1 class="article-title">{title}</h1>
        {description && <p class="article-description">{description}</p>}
        {tags.length > 0 && (
          <div class="article-tags">
            {tags.map(tag => (
              <span class="article-tag">{tag}</span>
            ))}
          </div>
        )}
      </header>
      {heroImage && <figure class="article-cover"><img src={heroImage} alt={title} width="820" height="513" loading="eager" decoding="async" /></figure>}
      <div class="article-content prose max-w-none">
        <slot />
      </div>
      <footer class="article-footer">
        <p class="article-author">Autor: {resolvedAuthor}</p>
        {updatedAt && (
          <p class="article-updated">
            Ostatnia aktualizacja: <time datetime={updatedAt.toISOString()}>
              {new Intl.DateTimeFormat('pl-PL', { year: 'numeric', month: 'long', day: 'numeric' }).format(updatedAt)}
            </time>
          </p>
        )}
        <a href="/blog" class="back-to-blog">← Wróć do bloga</a>
      </footer>
      <slot name="related" />
    </article>
  </main>
  <Footer />
</Base>
