---
import Base from './Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import type { SeoAlternates } from '@/lib/seo';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  robots?: string;
  alternates?: SeoAlternates;
}

const { title, description, canonical, ogImage, robots, alternates } = Astro.props;
---
<Base
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  robots={robots}
  alternates={alternates}
>
  <slot name="head" slot="head" />
  <Nav />
  <main id="main" class="site-main" aria-label="Główna treść">
    <slot />
  </main>
  <Footer />
</Base>
