---
export const prerender = true;

import Base from '@/components/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import { PRIVACY_POLICY } from '@/data/legal';
import { SITE } from '@/data/site';
import { buildLegalSchema } from '@/lib/schema';

const doc = PRIVACY_POLICY;
const title = `${doc.title} — ${SITE.displayName}`;
const canonical = '/polityka-prywatnosci';
const schema = buildLegalSchema({
  canonical,
  title,
  description: doc.lead,
  language: SITE.locale,
});
---

<Base title={title} description={doc.lead} canonical={canonical} lang={SITE.locale}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>
  <Nav />
  <main id="main" class="legal-main">
    <div class="legal-container">
      <header class="legal-header">
        <p class="article-meta">{doc.lastUpdatedLabel}</p>
        <h1 class="page-title">{doc.title}</h1>
        <p class="article-description">{doc.lead}</p>
        <p class="legal-disclaimer">{doc.disclaimer}</p>
      </header>

      {doc.sections.map((section) => (
        <section class="legal-section">
          <h2>{section.title}</h2>
          {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
          {section.bullets && (
            <ul>
              {section.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
          )}
        </section>
      ))}
    </div>
  </main>
  <Footer />
</Base>
