---
export const prerender = true;

import BlogPost from '@/components/layouts/BlogPost.astro';
import BlogCard from '@/components/BlogCard.astro';
import { getPublishedPostBySlug, getPublishedPosts, getRelatedPosts } from '@/lib/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

const article = await getPublishedPostBySlug(slug);
if (!article) {
  return Astro.redirect('/404');
}

const relatedArticles = await getRelatedPosts(article, 3);
const { Content } = await article.entry.render();
---

<BlogPost
  title={article.title}
  description={article.excerpt}
  publishedAt={article.pubDate}
  updatedAt={article.updatedDate}
  readingTime={article.readingTime}
  tags={article.tags}
  slug={article.slug}
  canonicalUrl={article.canonicalUrl}
>
  <Content />

  {relatedArticles.length > 0 && (
    <aside class="related-articles">
      <h2 class="related-title">Powiązane wpisy</h2>
      <div class="related-grid">
        {relatedArticles.map(related => (
          <BlogCard
            title={related.title}
            description={related.excerpt}
            date={related.pubDate}
            readingTime={related.readingTime}
            tags={related.tags}
            slug={related.slug}
          />
        ))}
      </div>
    </aside>
  )}
</BlogPost>
