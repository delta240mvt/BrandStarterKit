---
export const prerender = true;

import Base from '@/components/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import BlogCard from '@/components/BlogCard.astro';
import { BLOG_PAGE_SIZE, getPaginatedPosts, getPublishedTags } from '@/lib/blog';
import { getSitePresentation } from '@/lib/site';
import { buildCollectionSchema } from '@/lib/schema';

const site = getSitePresentation();
const { posts, page, totalPages } = await getPaginatedPosts(1, BLOG_PAGE_SIZE);
const topics = await getPublishedTags();
const nextHref = '/blog/2';
const title = site.blogTitle;
const canonical = '/blog';
const schema = buildCollectionSchema({
  canonical,
  title,
  description: site.blogDescription,
});
---

<Base
  title={title}
  description={site.blogDescription}
  canonical={canonical}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>
  <Nav />
  <main class="blog-list-main" aria-label="Blog posts">
    <div class="blog-list-container">
      <header class="blog-list-header">
        <h1 class="blog-list-title">/blog</h1>
        {topics.length > 0 && (
          <section class="topic-section" aria-labelledby="blog-topic-heading">
            <h2 id="blog-topic-heading" class="topic-section-title">Tematy</h2>
            <ul class="topic-list">
              {topics.map((topic) => (
                <li><span class="topic-chip">{topic}</span></li>
              ))}
            </ul>
          </section>
        )}
      </header>

      {posts.length > 0 ? (
        <div class="blog-grid">
          {posts.map((post, i) => (
            <BlogCard
              title={post.title}
              description={post.excerpt}
              date={post.pubDate}
              readingTime={post.readingTime}
              tags={post.tags}
              slug={post.slug}
              featured={i === 0}
            />
          ))}
        </div>
      ) : (
        <p class="empty-state">Brak wpisów. Wróć tu wkrótce.</p>
      )}

      {totalPages > 1 && (
        <nav class="pagination" aria-label="Blog pagination">
          <span class="page-info">Strona {page} z {totalPages}</span>
          {page < totalPages && (
            <a href={nextHref} class="page-btn">Następna →</a>
          )}
        </nav>
      )}
    </div>
  </main>
  <Footer />
</Base>

<style>
  .blog-list-main {
    padding-top: 3.5rem;
    min-height: 100vh;
    background-color: var(--bg-base);
  }
  .blog-list-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }
  .blog-list-header {
    margin-bottom: 2.5rem;
  }
  .blog-list-title {
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    color: var(--teal);
    margin-bottom: 0.75rem;
  }
  .topic-section {
    margin-top: 0.75rem;
  }
  .topic-section-title {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-weight: 400;
    margin-bottom: 0.6rem;
  }
  .topic-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .topic-chip {
    display: inline-flex;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    background: var(--violet-glow);
    color: var(--text-primary);
    border: 1px solid rgba(138,78,100,0.2);
  }
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin-bottom: 3rem;
  }
  .empty-state {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    padding: 3rem 0;
  }
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
  }
  .page-btn {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--teal);
    text-decoration: none;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    transition: all 0.15s;
  }
  .page-btn:hover { border-color: var(--teal); }
  .page-info {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  @media (max-width: 640px) {
    .blog-grid { grid-template-columns: 1fr; }
  }
</style>
