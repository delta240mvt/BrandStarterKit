---
import Base from '@/components/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import BlogCard from '@/components/BlogCard.astro';
import { BLOG_PAGE_SIZE, getPaginatedPosts, getPublishedTags } from '@/lib/blog';
import { getSitePresentation } from '@/lib/site';
import { buildCollectionSchema } from '@/lib/schema';

export async function getStaticPaths() {
  const { totalPages } = await getPaginatedPosts(1, BLOG_PAGE_SIZE);
  const paths = [];

  for (let page = 2; page <= totalPages; page += 1) {
    paths.push({ params: { page: String(page) } });
  }

  return paths;
}

const requestedPage = Number(Astro.params.page);
const site = getSitePresentation();
const { posts, page, totalPages } = await getPaginatedPosts(requestedPage, BLOG_PAGE_SIZE);
const topics = await getPublishedTags();
const prevHref = page === 2 ? '/blog' : `/blog/${page - 1}`;
const nextHref = `/blog/${page + 1}`;
const title = `${site.blogTitle} — Strona ${page}`;
const canonical = `/blog/${page}`;
const schema = buildCollectionSchema({
  canonical,
  title,
  description: site.blogDescription,
  page,
});
---

<Base
  title={title}
  description={site.blogDescription}
  canonical={canonical}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>
  <Nav />
  <main id="main" class="blog-list-main" aria-label="Wpisy blogowe">
    <div class="blog-list-container brand-shell">
      <header class="blog-list-header">
        <p class="section-heading">Blog</p>
        <h1 class="blog-list-title">Wpisy blogowe - strona {page}</h1>
        {topics.length > 0 && (
          <section class="topic-section" aria-labelledby="blog-topic-heading">
            <h2 id="blog-topic-heading" class="topic-section-title">Tematy</h2>
            <ul class="topic-list">
              {topics.map((topic) => (
                <li><span class="topic-chip">{topic}</span></li>
              ))}
            </ul>
          </section>
        )}
      </header>

      {posts.length > 0 ? (
        <div class="blog-grid">
          {posts.map((post, i) => (
            <BlogCard
              title={post.title}
              description={post.excerpt}
              date={post.pubDate}
              readingTime={post.readingTime}
              tags={post.tags}
              slug={post.slug}
              featured={i === 0}
              image={post.heroImage ? { src: post.heroImage, alt: post.title } : undefined}
            />
          ))}
        </div>
      ) : (
        <p class="empty-state">Brak wpisów. Wróć tu wkrótce.</p>
      )}

      {totalPages > 1 && (
        <nav class="pagination" aria-label="Paginacja bloga">
          <a href={prevHref} class="page-btn">← Poprzednia</a>
          <span class="page-info">Strona {page} z {totalPages}</span>
          {page < totalPages && (
            <a href={nextHref} class="page-btn">Następna →</a>
          )}
        </nav>
      )}
    </div>
  </main>
  <Footer />
</Base>
