---
export const prerender = true;

import Landing from '@/components/layouts/Landing.astro';
import Hero from '@/components/Hero.astro';
import Benefits from '@/components/Benefits.astro';
import About from '@/components/About.astro';
import Services from '@/components/Services.astro';
import Process from '@/components/Process.astro';
import Projects from '@/components/Projects.astro';
import Testimonials from '@/components/Testimonials.astro';
import Faq from '@/components/Faq.astro';
import BlogPreview from '@/components/BlogPreview.astro';
import Contact from '@/components/Contact.astro';
import { getSitePresentation } from '@/lib/site';
import { buildHomeSchema } from '@/lib/schema';

const site = getSitePresentation();
const schema = buildHomeSchema();
---

<Landing title={site.defaultTitle} description={site.defaultDescription}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <>
    <Hero />
    <Benefits />
    <About />
    <Services />
    <Process />
    <Projects />
    <Testimonials />
    <Faq />
    <BlogPreview />
    <Contact />
  </>
</Landing>

<script>
  import { observeRevealElements } from '@/utils/animations';
  document.addEventListener('DOMContentLoaded', observeRevealElements);
</script>

<style>
</style>
